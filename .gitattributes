# Auto detect text files and normalize line endings to LF
* text=auto

# Force Unix line endings
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cfg text eol=lf

# Binary files
*.pkl binary
*.pth binary
*.mp4 binary
*.jpg binary
*.png binary
